{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadoc.dev/schema/settings.schema.json",
  "title": "HAdoc settings",
  "description": "House-wide settings, including the configurable point ID scheme and abbreviations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ids",
    "levels",
    "types"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the house, shown in the app header."
    },
    "language": {
      "type": "string",
      "description": "UI language hint, e.g. 'nl' or 'en'."
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Point ID pattern. Placeholders: {level}, {room}, {type}, {nr}.",
          "default": "{level}-{room}-{type}-{nr}"
        },
        "nr_digits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 2
        }
      }
    },
    "levels": {
      "type": "array",
      "description": "Level codes as used in IDs, e.g. MIN1, 0, 1.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "types": {
      "type": "array",
      "description": "Point type abbreviations, e.g. PIR, SW, LGT.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string",
            "description": "Short text shown on the plan symbol; defaults to the code."
          },
          "layer": {
            "enum": [
              "power",
              "data",
              "automation",
              "hidden"
            ],
            "default": "power"
          }
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "description": "Files exported from other systems, read on every load.",
      "properties": {
        "wago": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config"
          ],
          "description": "CODESYS 2.3 PLC configuration export (Project > Export, PLC configuration).",
          "properties": {
            "config": {
              "type": "string",
              "description": "Path relative to the data folder, e.g. imports/PLC CONFIGURATION.EXP."
            },
            "controller": {
              "type": "string",
              "description": "Device ID of the PLC; modules get it as their location."
            },
            "id_prefix": {
              "type": "string",
              "default": "plc-",
              "description": "Prefix for module device IDs."
            }
          }
        },
        "esphome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir"
          ],
          "description": "Folder with ESPHome node configs (the ESPHome dashboard's config folder). Pins become device ports.",
          "properties": {
            "dir": {
              "type": "string",
              "description": "Path relative to the data folder, or absolute, e.g. /esphome."
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live connections to other systems, polled while the app runs. Secrets come from environment variables, never from this file.",
      "properties": {
        "poll_seconds": {
          "type": "number",
          "minimum": 10,
          "default": 60
        },
        "openhab": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "e.g. http://192.168.2.31:8080"
            },
            "token_env": {
              "type": "string",
              "description": "Variable holding an API token. Default HADOC_OPENHAB_TOKEN."
            }
          }
        },
        "unifi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "Network application URL, e.g. https://unifi.example.com"
            },
            "api_path": {
              "type": "string",
              "default": "/integration/v1",
              "description": "'/integration/v1' for a self-hosted Network application, '/proxy/network/integration/v1' on a UniFi OS console."
            },
            "site": {
              "type": "string",
              "default": "default",
              "description": "Site name or ID."
            },
            "key_env": {
              "type": "string",
              "description": "Variable holding the Integration API key. Default HADOC_UNIFI_KEY."
            },
            "subnets": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+/\\d+$"
              },
              "description": "Only report unknown clients in these subnets, e.g. ['192.168.20.0/24'] for the IoT VLAN. Default: every client."
            }
          }
        },
        "tasmota": {
          "type": "object",
          "additionalProperties": false,
          "description": "Polls every device with firmware Tasmota and a hostname.",
          "properties": {
            "user_env": {
              "type": "string",
              "description": "Variable with the web user, when a password is set. Default HADOC_TASMOTA_USER."
            },
            "password_env": {
              "type": "string",
              "description": "Variable with the web password. Default HADOC_TASMOTA_PASSWORD."
            }
          }
        },
        "mqtt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "e.g. mqtt://192.168.2.9:1883"
            },
            "username_env": {
              "type": "string",
              "description": "Default HADOC_MQTT_USER."
            },
            "password_env": {
              "type": "string",
              "description": "Default HADOC_MQTT_PASSWORD."
            }
          }
        }
      }
    }
  }
}
