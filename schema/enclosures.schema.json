{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadoc.dev/schema/enclosures.schema.json",
  "title": "HAdoc enclosures",
  "description": "Distribution boards, PLC cabinets, network racks.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "level": { "type": ["string", "null"] },
      "room": { "type": ["string", "null"] },
      "pos": {
        "oneOf": [
          { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          { "type": "null" }
        ]
      },
      "rails": { "type": "integer", "minimum": 1, "description": "Number of DIN rails." },
      "photo": { "type": "string" },
      "notes": { "type": "string" }
    }
  }
}
